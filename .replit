modules = ["nodejs-20", "web", "postgresql-16"]
run = "PORT=5000 npm start"

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "PORT=5000 npm start"]
build = ["sh", "-c", "npm ci --omit=dev"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
