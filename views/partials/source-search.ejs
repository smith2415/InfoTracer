<section class="tool-card" id="source-search" aria-labelledby="source-search-heading">
  <div class="tool-card-row">
    <div>
      <h2 id="source-search-heading">Source search</h2>
      <p class="muted">Search Bluesky, news coverage (GDELT) and Xpoz and save the <%= savePerSource %> earliest matches from each as observations. Fill in anything shown as "-". A search can take up to a minute; the progress shows which sources are done.</p>
    </div>
    <form method="post" action="/claims/<%= claim.id %>/source-search" class="factcheck-form" data-source-search>
      <label for="ss-q" class="visually-hidden">Search sources for</label>
      <input id="ss-q" name="q" value="<%= sourceSearch ? sourceSearch.query : (claim.hook || claim.claim_text) %>" maxlength="200">
      <button type="submit" class="button button-seed">Search sources</button>
    </form>
  </div>

  <div class="source-progress" id="source-progress" hidden>
    <p class="progress-status" role="status" aria-live="polite"></p>
    <ul class="progress-list"></ul>
  </div>

  <% if (sourceSearch) { %>
    <div class="source-results" role="status">
      <% if (sourceSearch.error) { %>
        <p class="form-error"><%= sourceSearch.error %></p>
      <% } %>
      <% sourceSearch.sources.forEach((s) => { %>
        <% if (s.error) { %>
          <p class="source-line source-error"><strong><%= s.label %>:</strong> <%= s.error %><%- include("source-time", { s }) %></p>
        <% } else if (s.found === 0) { %>
          <p class="source-line"><strong><%= s.label %>:</strong> no <%= s.unit || "post" %>s found for "<%= sourceSearch.query %>". Try the hook, or a shorter phrase.<%- include("source-time", { s }) %></p>
        <% } else { %>
          <p class="source-line">
            <strong><%= s.label %>:</strong> found <%= s.found %> <%= s.unit || "post" %><%= s.found === 1 ? "" : "s" %>; <% if (s.saved > 0) { %>saved the <%= s.saved === 1 ? "earliest" : s.saved + " earliest" %> as observation<%= s.saved === 1 ? "" : "s" %><% } else { %>nothing new to save<% } %><% if (s.alreadySaved > 0) { %> (<%= s.alreadySaved %> already saved)<% } %>.<%- include("source-time", { s }) %>
            <% if (s.warning) { %><span class="source-warning"><%= s.warning %></span><% } %>
            <% if (!s.reachedEnd) { %><span class="source-warning">Only the most recent <%= s.found %> matches were checked, so older posts may exist. A more specific phrase can reach further back.</span><% } %>
          </p>
        <% } %>
      <% }) %>
      <% if (sourceSearch.sources.some((s) => !s.error && s.found === 0)) { %>
        <div class="search-help">
          <p class="search-help-title">Not finding it? Try a different phrase:</p>
          <ul>
            <li><strong>Use two to four distinctive words,</strong> not the whole sentence: names, places, numbers and unusual words.</li>
            <li><strong>Drop filler</strong> like "will", "the" and "cause". "Billionaire tax" finds more than "billionaire tax will cause billionaires to flee".</li>
            <li><strong>Try the exact wording people repeat,</strong> and other ways of writing it ("$12 billion", "12 billion", "12bn").</li>
            <li><strong>Very new or very old claims</strong> may not be in every source yet, so a blank source isn't proof the claim isn't out there.</li>
          </ul>
        </div>
      <% } %>
    </div>
  <% } %>
</section>
<script src="/source-search.js" defer></script>
