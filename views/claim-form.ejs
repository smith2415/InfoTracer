<%- include("partials/header") %>
<% const errors = locals.errors || {}; %>
<section class="form-card">
  <h1><%= title %></h1>
  <% if (locals.errorSummary) { %>
    <p class="form-error" role="alert"><%= errorSummary %></p>
  <% } %>
  <form method="post" action="<%= action %>" novalidate>
    <label for="claim_text">Claim <span class="required">required</span></label>
    <textarea id="claim_text" name="claim_text" rows="3" placeholder="$12 billion was stolen from the bank"
      <% if (errors.claim_text) { %>aria-invalid="true" aria-describedby="claim_text-error" class="has-error"<% } %>><%= claim.claim_text || "" %></textarea>
    <%- include("partials/field-error", { errors, field: "claim_text" }) %>
    <p class="hint">The claim as you first saw it.</p>

    <label for="hook">Hook</label>
    <input id="hook" name="hook" value="<%= claim.hook || "" %>" placeholder="$12 billion">
    <p class="hint">The distinctive phrase that repeats as the claim spreads. This is what you'll search for.</p>

    <label for="status">Status</label>
    <select id="status" name="status">
      <% statuses.forEach((status) => { %>
        <option value="<%= status %>" <%= claim.status === status ? "selected" : "" %>><%= status %></option>
      <% }) %>
    </select>

    <label for="notes">Notes</label>
    <textarea id="notes" name="notes" rows="4"
      <% if (errors.notes) { %>aria-invalid="true" aria-describedby="notes-error" class="has-error"<% } %>><%= claim.notes || "" %></textarea>
    <%- include("partials/field-error", { errors, field: "notes" }) %>
    <p class="hint">Up to 2,000 characters.</p>

    <div class="form-actions">
      <button type="submit" class="button button-seed">Save claim</button>
      <a class="button" href="<%= claim.id ? '/claims/' + claim.id : '/claims' %>">Cancel</a>
    </div>
  </form>
</section>
<%- include("partials/footer") %>
