<%- include("partials/header") %>
<p class="breadcrumb"><a href="/claims/<%= claim.id %>#pinned-fact-checks">← "<%= claim.claim_text %>"</a></p>

<section>
  <div class="page-head">
    <div>
      <h1>Fact-checks</h1>
      <p class="muted">Published fact-checks from Google Fact Check Explorer, which collects reviews from fact-checking organizations.</p>
    </div>
  </div>

  <% if (pinNote) { %>
    <p class="pin-note" role="status">
      <%= pinNote === "pinned" ? "Pinned to this claim." : "Unpinned from this claim." %>
      Pinned fact-checks appear in the Fact-check box on the claim's page.
      <a href="/claims/<%= claim.id %>#pinned-fact-checks">See your pinned fact-checks →</a>
    </p>
  <% } else if (pinned.size > 0) { %>
    <p class="pin-note pin-note-quiet">
      <%= pinned.size %> fact-check<%= pinned.size === 1 ? " is" : "s are" %> pinned to this claim.
      <a href="/claims/<%= claim.id %>#pinned-fact-checks">See them on the claim's page →</a>
    </p>
  <% } %>

  <form method="get" action="/claims/<%= claim.id %>/fact-checks" class="factcheck-form factcheck-form-page" role="search">
    <label for="fc-q" class="visually-hidden">Search fact-checks for</label>
    <input id="fc-q" name="q" value="<%= query %>" maxlength="200" placeholder="A distinctive phrase from the claim">
    <button type="submit" class="button">Search</button>
  </form>

  <details class="search-tips" <%= !error && results && results.length === 0 ? "open" : "" %>>
    <summary>Search tips</summary>
    <ul>
      <li><strong>Search the distinctive part,</strong> not the whole sentence: names, places, numbers and unusual words.</li>
      <li><strong>Try a name plus one key word,</strong> like "Zelensky yachts" instead of the full claim.</li>
      <li><strong>Try other ways of writing numbers</strong> ("$12 billion," "12 billion," "12bn") and synonyms ("stolen," "embezzled").</li>
      <li><strong>Read each match:</strong> claims get recycled, so check the wording and date before relying on a rating.</li>
      <li><strong>No results doesn&rsquo;t mean true.</strong> The claim may be too new or worded differently.</li>
    </ul>
    <p class="search-tips-more"><a href="https://github.com/smith2415/InfoTracer/blob/main/docs/fact-check-guide.md" target="_blank" rel="noopener noreferrer">Read the full guide, with a worked example</a></p>
  </details>

  <% if (error) { %>
    <p class="form-error" role="alert"><%= error %></p>
  <% } else if (results.length === 0) { %>
    <div class="empty-state">
      <p class="empty-title">No fact-checks found for "<%= query %>"</p>
      <p class="muted">That doesn't mean the claim is true. It may be new, or fact-checkers may have worded it differently. Try the hook, or a shorter phrase.</p>
    </div>
  <% } else { %>
    <p class="result-count"><%= results.length %> fact-checked claim<%= results.length === 1 ? "" : "s" %> matching "<%= query %>"</p>
    <ol class="factcheck-list">
      <% results.forEach((r) => { %>
        <li class="factcheck-result">
          <p class="factcheck-claim">"<%= r.text || "Claim text not provided" %>"</p>
          <p class="factcheck-meta">
            <% if (r.claimant) { %>Claimed by <%= r.claimant %><% } %>
            <% if (r.claimant && r.claimDate) { %> · <% } %>
            <% if (r.claimDate) { %><%= formatDate(r.claimDate) %><% } %>
          </p>
          <ul class="review-list">
            <% r.reviews.forEach((rev) => { const link = safeUrl(rev.url); const pinId = link ? pinned.get(urlKey(link)) : null; %>
              <li class="review">
                <% if (rev.rating) { %><span class="rating rating-<%= ratingTone(rev.rating) %>"><%= rev.rating %></span><% } %>
                <div class="review-body">
                  <span class="review-source">
                    <strong><%= rev.publisher %></strong>
                    <% if (rev.reviewDate) { %><span class="muted-inline"> · <%= formatDate(rev.reviewDate) %></span><% } %>
                    <% if (rev.language && rev.language !== "en") { %><span class="tag"><%= rev.language %></span><% } %>
                  </span>
                  <% if (link) { %>
                    <a class="review-title" href="<%= link %>" target="_blank" rel="noopener noreferrer"><%= rev.title || "Read the fact-check" %></a>
                  <% } else if (rev.title) { %>
                    <span class="review-title"><%= rev.title %></span>
                  <% } %>
                </div>
                <% if (link) { %>
                  <% if (pinId) { %>
                    <form method="post" action="/fact-check-pins/<%= pinId %>/unpin" class="inline-form review-pin">
                      <input type="hidden" name="return_to" value="results">
                      <input type="hidden" name="unpinning" value="1">
                      <input type="hidden" name="q" value="<%= query %>">
                      <button type="submit" class="button button-small is-pinned" aria-label="Unpin this fact-check from the claim">Pinned ✓</button>
                    </form>
                  <% } else { %>
                    <form method="post" action="/claims/<%= claim.id %>/fact-checks/pin" class="inline-form review-pin">
                      <input type="hidden" name="return_to" value="results">
                      <input type="hidden" name="q" value="<%= query %>">
                      <input type="hidden" name="url" value="<%= link %>">
                      <input type="hidden" name="publisher" value="<%= rev.publisher %>">
                      <input type="hidden" name="title" value="<%= rev.title || "" %>">
                      <input type="hidden" name="rating" value="<%= rev.rating || "" %>">
                      <input type="hidden" name="review_date" value="<%= rev.reviewDate || "" %>">
                      <input type="hidden" name="reviewed_claim" value="<%= r.text %>">
                      <input type="hidden" name="claimant" value="<%= r.claimant || "" %>">
                      <button type="submit" class="button button-small" aria-label="Pin this fact-check to the claim">Pin</button>
                    </form>
                  <% } %>
                <% } %>
              </li>
            <% }) %>
          </ul>
        </li>
      <% }) %>
    </ol>
  <% } %>
</section>
<%- include("partials/footer") %>
