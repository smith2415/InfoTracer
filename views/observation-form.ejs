<%- include("partials/header") %>
<p class="breadcrumb"><a href="/claims/<%= claim.id %>">← "<%= claim.claim_text %>"</a></p>
<section class="form-card">
  <h1><%= title %></h1>
  <p class="muted">Leave anything you don't know blank; it shows as "-" until you fill it in.</p>
  <form method="post" action="<%= action %>">
    <label for="observed_at">Posted at (UTC)</label>
    <input id="observed_at" name="observed_at" type="datetime-local" value="<%= toDateTimeInput(observation.observed_at) %>">

    <label for="location">Location</label>
    <input id="location" name="location" value="<%= observation.location || "" %>" placeholder="X, Instagram, a news site" list="location-options">
    <datalist id="location-options">
      <option value="X"><option value="Bluesky"><option value="Instagram"><option value="TikTok">
      <option value="Facebook"><option value="Reddit"><option value="Telegram"><option value="YouTube">
      <option value="News site"><option value="Blog">
    </datalist>

    <label for="poster">Poster</label>
    <input id="poster" name="poster" value="<%= observation.poster || "" %>" placeholder="@account, organization or author">

    <label for="post_text">Exact wording</label>
    <textarea id="post_text" name="post_text" rows="4" maxlength="2000" class="mono"><%= observation.post_text || "" %></textarea>
    <p class="hint">Copy the post word for word, up to 2,000 characters.</p>

    <label for="url">Link</label>
    <input id="url" name="url" type="url" value="<%= observation.url || "" %>" placeholder="https://">

    <label for="notes">Notes</label>
    <textarea id="notes" name="notes" rows="3" maxlength="2000"><%= observation.notes || "" %></textarea>

    <div class="form-actions">
      <button type="submit" class="button button-seed">Save observation</button>
      <a class="button" href="/claims/<%= claim.id %>">Cancel</a>
    </div>
  </form>
</section>
<%- include("partials/footer") %>
