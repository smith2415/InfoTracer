<%- include("partials/header") %>
<p class="breadcrumb"><a href="/claims">← Your claims</a></p>

<section class="case-file">
  <div class="case-head">
    <div>
      <p class="label">Claim</p>
      <h1>"<%= claim.claim_text %>"</h1>
      <div class="case-meta">
        <span class="badge badge-<%= claim.status.replace(' ', '-') %>"><%= claim.status %></span>
        <span class="tag">hook: <%= dash(claim.hook) %></span>
        <span class="muted-inline">opened <%= formatDate(claim.created_at) %></span>
      </div>
    </div>
    <div class="case-actions">
      <a class="button" href="/claims/<%= claim.id %>/edit">Edit</a>
      <a class="button button-weed" href="/claims/<%= claim.id %>/delete">Delete</a>
    </div>
  </div>
  <% if (claim.notes) { %>
    <p class="label">Notes</p>
    <p class="notes"><%= claim.notes %></p>
  <% } %>
</section>

<section class="factcheck-card" aria-labelledby="factcheck-heading">
  <div>
    <h2 id="factcheck-heading">Fact-check lookup</h2>
    <p class="muted">See whether fact-checkers have already looked at this claim.</p>
  </div>
  <form method="get" action="/claims/<%= claim.id %>/fact-checks" class="factcheck-form" role="search">
    <label for="fc-q" class="visually-hidden">Search fact-checks for</label>
    <input id="fc-q" name="q" value="<%= claim.hook || claim.claim_text %>" maxlength="200">
    <button type="submit" class="button">Search fact-checks</button>
  </form>
</section>

<% if (observations.length > 0) { %>
  <%- include("partials/timeline", { timeline }) %>
<% } %>

<section>
  <div class="page-head">
    <h2>Observations <span class="count"><%= observations.length %></span></h2>
    <a class="button button-seed" href="/claims/<%= claim.id %>/observations/new">Add observation</a>
  </div>

  <% if (observations.length === 0) { %>
    <div class="empty-state">
      <p class="empty-title">No observations yet</p>
      <p class="muted">Record each place this claim appears: when, where and who posted it.</p>
    </div>
  <% } else { %>
    <ol class="evidence-list">
      <% observations.forEach((o) => { %>
        <%- include("partials/evidence-card", { o, context: "claim" }) %>
      <% }) %>
    </ol>
  <% } %>
</section>
<%- include("partials/footer") %>
