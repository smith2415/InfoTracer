<%- include("partials/header") %>
<p class="breadcrumb"><a href="/claims">← Your claims</a></p>

<section class="case-file">
  <div class="case-head">
    <div>
      <p class="label">Claim</p>
      <h1>"<%= claim.claim_text %>"</h1>
      <div class="case-meta">
        <span class="badge badge-<%= claim.status.replace(' ', '-') %>"><%= claim.status %></span>
        <span class="tag">hook: <%= dash(claim.hook) %></span>
        <span class="muted-inline">opened <%= formatDate(claim.created_at) %></span>
      </div>
    </div>
    <div class="case-actions">
      <a class="button" href="/claims/<%= claim.id %>/edit">Edit</a>
      <a class="button button-weed" href="/claims/<%= claim.id %>/delete">Delete</a>
    </div>
  </div>
  <% if (claim.notes) { %>
    <p class="label">Notes</p>
    <p class="notes"><%= claim.notes %></p>
  <% } %>
</section>

<section class="tool-card" id="pinned-fact-checks" aria-labelledby="factcheck-heading">
  <div class="tool-card-row">
    <div>
      <h2 id="factcheck-heading">Fact-check lookup</h2>
      <p class="muted">See whether fact-checkers have already looked at this claim, and pin the ones you rely on.</p>
    </div>
    <form method="get" action="/claims/<%= claim.id %>/fact-checks" class="factcheck-form" role="search">
      <label for="fc-q" class="visually-hidden">Search fact-checks for</label>
      <input id="fc-q" name="q" value="<%= claim.hook || claim.claim_text %>" maxlength="200">
      <button type="submit" class="button">Search fact-checks</button>
    </form>
  </div>

  <% if (pins.length > 0) { %>
    <div class="pinned-list">
      <h3 class="pinned-heading">Pinned fact-checks <span class="count"><%= pins.length %></span></h3>
      <ul class="review-list">
        <% pins.forEach((p) => { const link = safeUrl(p.url); %>
          <li class="review">
            <% if (p.rating) { %><span class="rating rating-<%= ratingTone(p.rating) %>"><%= p.rating %></span><% } %>
            <div class="review-body">
              <span class="review-source">
                <strong><%= p.publisher || "Unknown publisher" %></strong>
                <% if (p.review_date) { %><span class="muted-inline"> · <%= formatDate(p.review_date) %></span><% } %>
              </span>
              <% if (link) { %><a class="review-title" href="<%= link %>" target="_blank" rel="noopener noreferrer"><%= p.title || "Read the fact-check" %></a><% } %>
              <% if (p.reviewed_claim) { %><span class="pinned-claim">Reviewed: "<%= p.reviewed_claim %>"<% if (p.claimant) { %> (<%= p.claimant %>)<% } %></span><% } %>
            </div>
            <form method="post" action="/fact-check-pins/<%= p.id %>/unpin" class="inline-form review-pin">
              <button type="submit" class="link-button unpin-link" aria-label="Unpin this fact-check">Unpin</button>
            </form>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>
</section>

<%- include("partials/source-search", { claim, sourceSearch, savePerSource }) %>

<% if (observations.length > 0) { %>
  <%- include("partials/timeline", { timeline }) %>
<% } %>

<section>
  <div class="page-head">
    <h2>Observations <span class="count"><%= observations.length %></span></h2>
    <a class="button button-seed" href="/claims/<%= claim.id %>/observations/new">Add observation</a>
  </div>

  <% if (observations.length === 0) { %>
    <div class="empty-state">
      <p class="empty-title">No observations yet</p>
      <p class="muted">Record each place this claim appears: when, where and who posted it.</p>
    </div>
  <% } else { %>
    <ol class="evidence-list">
      <% observations.forEach((o) => { %>
        <%- include("partials/evidence-card", { o, context: "claim" }) %>
      <% }) %>
    </ol>
  <% } %>
</section>
<%- include("partials/footer") %>
