  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.6.1",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^5.0.5"
  }
